{
  "name": "gestion-scolaire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-sw.mts",
    "start": "next start",
    "lint": "next typegen && eslint && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:setup": "node scripts/db-setup.mts",
    "db:migrate": "node scripts/db-setup.mts",
    "superadmin:create": "node scripts/create-superadmin.mts",
    "password:reset": "node scripts/reset-password.mts",
    "storage:check": "node scripts/storage-check.mts",
    "demo:seed": "node --import tsx --conditions=react-server scripts/demo-seed.mts",
    "worker": "node --import tsx --conditions=react-server src/worker/index.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "dexie": "4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "drizzle-orm": "0.45.4",
    "exceljs": "^4.4.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.2",
    "playwright-core": "1.65.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "serwist": "9.5.15",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fake-indexeddb": "^6.2.8",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  }
}
