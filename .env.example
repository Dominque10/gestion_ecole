# Copier ce fichier en .env et remplir les valeurs. Ne jamais committer .env.

# Base de données (PostgreSQL 16)
# Application : rôle app_user, soumis à la RLS (le nom du rôle est imposé).
DATABASE_URL=postgres://app_user:change-moi@localhost:5434/gestion_scolaire
# Migrations : compte administrateur, propriétaire des tables.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5434/gestion_scolaire

# Secret de signature (liens de vérification des reçus). Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Adresse publique de l'application (QR code des reçus)
APP_URL=http://localhost:3000

# Fichiers envoyés (logo, cachet, signature, photos et pièces) : dossier sur le disque (décision D30).
# En production : chemin absolu, sur un volume sauvegardé (/app/storage dans docker-compose.prod.yml).
# Vérification fichiers / base : pnpm storage:check
STORAGE_DIR=storage

# Fuseau d'affichage
APP_TIMEZONE=Africa/Brazzaville

# Mode démonstration : en production (NODE_ENV=production), l'application et le worker refusent de
# démarrer avec un faux prestataire, sauf DEMO_MODE=true (bandeau « Démonstration » sur chaque page).
# DEMO_MODE=false

# Prestataires (faux prestataires de test pour l'instant — décision D1)
# PAYMENT_PROVIDER=fake   (faux prestataire de test, par défaut ; le vrai est choisi au point B4)
# PAYMENT_API_KEY=
# PAYMENT_WEBHOOK_SECRET=   (signature HMAC-SHA256 des messages de confirmation ; 32 caractères au moins en production)
# SMS_PROVIDER=fake   (faux prestataire de test, par défaut ; le vrai est choisi au M6)
# SMS_API_KEY=
# WHATSAPP_PROVIDER=fake   (faux prestataire WhatsApp, par défaut)
