# Copier ce fichier en .env et remplir les valeurs. Ne jamais committer .env.
# Les variables seront complétées au fil de la Phase 1.

# Base de données (PostgreSQL 16)
DATABASE_URL=postgres://user:password@localhost:5432/gestion_scolaire

# Authentification
AUTH_SECRET=

# Fuseau d'affichage
APP_TIMEZONE=Africa/Brazzaville

# Prestataires (à choisir en phase 0 — voir docs/cadrage.md B4, B5)
# PAYMENT_PROVIDER=
# PAYMENT_API_KEY=
# PAYMENT_WEBHOOK_SECRET=
# SMS_PROVIDER=
# SMS_API_KEY=
