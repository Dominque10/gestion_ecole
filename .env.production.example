# Réglages de production (docker-compose.prod.yml). Le script deploy/install.sh crée le fichier
# .env.production à partir de ces lignes, en générant lui-même les secrets. Ne jamais committer
# .env.production ; droits : lecture par root seul (chmod 600).

# --- Adresse publique ---
# Nom de domaine du site (doit pointer vers l'adresse IP du serveur avant l'installation).
APP_DOMAIN=ecole.exemple.cg
# Adresse e-mail pour Let's Encrypt (avis d'expiration du certificat HTTPS).
ACME_EMAIL=alertes@exemple.cg

# --- Secrets générés à l'installation (ne pas les inventer à la main) ---
# Mot de passe du compte administrateur de PostgreSQL (migrations, sauvegardes).
POSTGRES_PASSWORD=
# Mot de passe du compte app_user (application et worker). Changeable : modifier ici, puis
# « docker compose ... up -d » (le service migrate met le compte à jour).
APP_DB_PASSWORD=
# Signature des QR codes des reçus. NE PAS CHANGER sans raison grave : les QR codes déjà imprimés
# ne seraient plus reconnus.
AUTH_SECRET=

# --- Prestataires ---
# Tant que les vrais prestataires de paiement et de SMS ne sont pas choisis (B4, B5), seule une
# démonstration est possible : DEMO_MODE=true (bandeau sur chaque page, aucun paiement réel).
DEMO_MODE=true
# Site de démonstration PUBLIC seulement (Sg) : école fictive, comptes affichés sur la page de
# connexion, code des parents affiché à l'écran, TOUT EFFACÉ chaque nuit. Jamais pour une vraie école.
# Pour l'activer : DEMO_SITE=true, DEMO_MODE=true et COMPOSE_PROFILES=demo (lance le service « demo »).
DEMO_SITE=false
# COMPOSE_PROFILES=demo
# DEMO_RESET_TIME=03:30
PAYMENT_PROVIDER=fake
PAYMENT_API_KEY=
# Secret des confirmations de paiement (32 caractères au moins hors démonstration).
PAYMENT_WEBHOOK_SECRET=
SMS_PROVIDER=fake
SMS_API_KEY=
WHATSAPP_PROVIDER=fake

# --- Sauvegardes (décision D33 : Backblaze B2) ---
# Dépôt : s3:https://<point d'accès S3 du bucket>/<nom du bucket>/gestion-scolaire
BACKUP_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/mon-bucket/gestion-scolaire
# Clé d'application B2 limitée au bucket (keyID et applicationKey).
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
# Clé de chiffrement des sauvegardes, générée à l'installation. À GARDER HORS DU SERVEUR :
# gestionnaire de mots de passe du porteur du projet + copie papier dans un lieu sûr. Sans elle,
# aucune restauration n'est possible.
BACKUP_PASSWORD=
# Heure de la sauvegarde de nuit (heure de Brazzaville).
BACKUP_TIME=02:30
# Supervision (Se) : adresse de contrôle Healthchecks.io (https://hc-ping.com/<identifiant>).
BACKUP_PING_URL=

# --- Version ---
# Étiquette des images construites (ex. la date de mise à jour) ; facultatif.
APP_VERSION=latest
